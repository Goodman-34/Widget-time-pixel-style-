{
  "name": "pixel-drive-clock",
  "version": "1.0.2",
  "description": "Widget jam pixel-art untuk Windows: pickup silver melintasi lapangan bunga, dengan siklus pagi/siang/sore/malam yang berpindah mulus.",
  "author": "Goodman-34",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "homepage": "https://github.com/Goodman-34/Widget-time-pixel-style-#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Goodman-34/Widget-time-pixel-style-.git"
  },
  "bugs": {
    "url": "https://github.com/Goodman-34/Widget-time-pixel-style-/issues"
  },
  "keywords": [
    "electron",
    "widget",
    "clock",
    "pixel-art",
    "desktop-widget",
    "windows",
    "day-night-cycle"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "neu run",
    "build": "neu build"
  },
  "dependencies": {},
  "build": {
    "appId": "com.pixeldrive.clock",
    "productName": "Pixel Drive Clock",
    "copyright": "Copyright (c) 2026",
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2"
  }
}
